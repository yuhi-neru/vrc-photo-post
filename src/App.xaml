<Application x:Class="VrcPhotoPost.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#102337"/><SolidColorBrush x:Key="Ink" Color="#ECF9FF"/>
    <SolidColorBrush x:Key="VrcAccent" Color="#31D3E9"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#ECF9FF"/><Setter Property="Background" Value="#18364B"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="#365970" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#31D3E9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#A997FF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECF9FF"/><Setter Property="CaretBrush" Value="#31D3E9"/><Setter Property="Background" Value="#102A3E"/><Setter Property="BorderBrush" Value="#365970"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECF9FF"/></Style>
  </Application.Resources>
</Application>
